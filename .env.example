# ---- Leave everything blank to run in local demo mode (embedded PGlite + demo sign-in). ----

# Supabase Postgres connection string (Settings → Database → Connection string → "Transaction pooler").
DATABASE_URL=

# Supabase project (enables Google Sign-In and screenshot storage).
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings → API Keys. Publishable key (sb_publishable_…); older projects can set NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…), server-only; older projects can set SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SECRET_KEY=
# Storage bucket for opt-in proofs and check-in screenshots (create it as public in Supabase).
SUPABASE_PROOF_BUCKET=proofs

# The one shared Google Group every member joins and every developer adds to their closed track.
NEXT_PUBLIC_GOOGLE_GROUP_URL=https://groups.google.com/g/your-tester-group
NEXT_PUBLIC_GOOGLE_GROUP_EMAIL=your-tester-group@googlegroups.com

# Comma-separated emails that get the Admin screen.
ADMIN_EMAILS=

# Shared secret for the daily cron endpoint (GET /api/cron with header Authorization: Bearer <secret>).
CRON_SECRET=

# Optional base URL for the axios client (src/lib/axios.ts). Defaults to this app's own /api routes.
NEXT_PUBLIC_API_URL=
